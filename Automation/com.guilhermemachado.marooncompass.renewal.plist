<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.guilhermemachado.marooncompass.renewal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/guilhermemachado/Library/Application Support/Maroon Compass Renewal/Project/Tools/RenewDeviceInstallation.zsh</string>
